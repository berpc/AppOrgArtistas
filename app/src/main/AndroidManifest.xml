<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppOrgArtistas">

        <!-- Main -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Login -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"/>

        <!-- Register -->
        <activity
            android:name=".ui.activities.RegisterActivity"
            android:exported="false"/>

        <!-- Dashboard -->
        <activity
            android:name=".ui.activities.SetlistDashboardActivity"
            android:exported="false"/>

        <!-- Crear -->
        <activity
            android:name=".ui.activities.CreateSetlistActivity"
            android:exported="false"/>

        <!-- Detalle -->
        <activity
            android:name=".ui.activities.SetlistDetailActivity"
            android:exported="false"/>
        <!-- camara -->
        <activity
            android:name=".activities.CameraActivity"
            android:exported="false"/>

        <!-- PDF -->
        <activity
            android:name=".ui.activities.PdfViewerActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.SetlistDetailActivity"/>

    </application>

</manifest>