<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capturar Partitura"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- Subtitulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tomá una foto para convertirla en PDF"
        android:textSize="14sp"
        android:textColor="#94A3B8" />
    <TextView
        android:id="@+id/tvPageCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=" 0 páginas capturadas"
        android:textColor="#60A5FA"
        android:textStyle="bold"/>

    <!-- Vista previa -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPreviewFotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Botón foto -->
    <Button
        android:id="@+id/btnCapturar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#EA580C"
        android:text="Capturar Página"
        android:textColor="#FFFFFF" />

    <!-- Botón usar -->
    <Button
        android:id="@+id/btnSubir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#16A34A"
        android:textStyle="bold"
        android:text="📄 Generar PDF"
        android:textColor="#FFFFFF" />

</LinearLayout>