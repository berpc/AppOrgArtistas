<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Ícono música -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="40dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo App"
            android:layout_gravity="center" />

        <!-- Bienvenido/a -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/title_login_bienvenido_a"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_login_inicia_sesion_para_continuar"
            android:textSize="14sp"
            android:textColor="#888888" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:hint="@string/hint_login_email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/bg_edittext" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_login_contrasenia"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@drawable/bg_edittext" />

        <!-- Botón Iniciar sesión -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_login_iniciar_sesion"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6B4EFF" />

        <!-- Registrarse -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_login_no_tenes_cuenta_registrate"
            android:textColor="#6B4EFF"
            android:background="@null" />

    </LinearLayout>
</ScrollView>